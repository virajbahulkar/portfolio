---
import PdfDownloader from '@components/PdfDownloader';
import SkillsGrid from '@components/SkillsGrid';
import TimeLine from '@components/Timeline';
import { education, experience, profile, skills } from '@content/_cvData';
import { Footer } from '@partials/Footer';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';

const titleSuffix = ` - ${AppConfig.site_name}`;
const title = `Resume${titleSuffix}`;
const description = profile.summary;
const url = `${AppConfig.site_url}/cv/`;
const [email, phone, website, linkedin, github] = profile.contact
  .split('|')
  .map((item) => item.trim());
const contactItems = [
  {
    label: 'Email',
    value: email,
    href: email ? `mailto:${email}` : undefined,
  },
  {
    label: 'Phone',
    value: phone,
    href: phone ? `tel:${phone.replace(/\s+/g, '')}` : undefined,
  },
  {
    label: 'Website',
    value: website,
    href: website,
  },
  {
    label: 'LinkedIn',
    value: linkedin?.replace(/^https?:\/\/(www\.)?/i, ''),
    href: linkedin,
  },
  {
    label: 'GitHub',
    value: github?.replace(/^https?:\/\/(www\.)?/i, ''),
    href: github,
  },
].filter((item) => item.value);
---

<Base head={{ title, description, url }}>
  <section>
    <PdfDownloader client:load data={{ profile, education, experience, skills }}
    />
    <div class="mb-12">
      <header class="mb-8">
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
        >
          <h1 class="break-words text-3xl font-extrabold sm:text-4xl">
            {profile.name}
          </h1>
          <button
            id="download-pdf"
            type="button"
            disabled
            title="Download CV"
            aria-label="Download resume as PDF"
            style="background:transparent; border:none; padding:6px 10px; min-width:44px; min-height:44px; border-radius:6px; display:flex; align-items:center; justify-content:center;"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="currentColor"
              viewBox="0 0 16 16"
              style="display:block; font-weight:bold;"
            >
              <path
                d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"
                style="stroke:currentColor; stroke-width:2;"></path>
              <path
                d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"
                style="stroke:currentColor; stroke-width:2;"></path>
            </svg>
          </button>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {contactItems.map((item) => (
            <article class="rounded-xl border border-base-300 bg-base-200/60 px-4 py-3 shadow-sm transition hover:border-primary/60 hover:shadow-md">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-base-content/60">
                {item.label}
              </p>
              {item.href ? (
                <a
                  href={item.href}
                  class="mt-1 block break-words text-sm font-medium text-primary transition hover:text-secondary"
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={
                    item.href.startsWith('http')
                      ? 'noopener noreferrer'
                      : undefined
                  }
                >
                  {item.value}
                </a>
              ) : (
                <p class="mt-1 break-words text-sm font-medium">{item.value}</p>
              )}
            </article>
          ))}
        </div>
      </header>
      <p id="pdf-error" role="alert" class="text-error"></p>
      <noscript>Enable JavaScript to download the PDF résumé.</noscript>
      <div id="cv-content">
        <div class="mb-12">
          <h2 class="mb-6 text-2xl font-bold sm:text-3xl">Summary</h2>
          <p
            class="break-words text-base leading-7 sm:text-lg sm:leading-relaxed"
          >
            {profile.summary}
          </p>
        </div>
        <div class="mb-12">
          <h2 class="mb-6 text-2xl font-bold sm:text-3xl">Experience</h2>
          <div class="space-y-6">
            {experience.map((exp, index) => (
              <TimeLine
                title={exp.title}
                subtitle={exp.technologies}
                start={exp.start}
                end={exp.end}
                showLine={index < experience.length - 1}
              >
                {exp.projects &&
                  exp.projects.map((proj) => (
                    <div>
                      <strong>{proj.name}</strong>
                      <ul class="list-disc space-y-1 pl-5">
                        {proj.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                {exp.bullets && (
                  <ul class="list-disc space-y-1 pl-5">
                    {exp.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
              </TimeLine>
            ))}
          </div>
        </div>
        <div class="mb-12">
          <h2 class="mb-6 text-2xl font-bold sm:text-3xl">Skills</h2>
          <SkillsGrid />
        </div>
        <div class="mb-12">
          <h2 class="mb-6 text-2xl font-bold sm:text-3xl">Education</h2>
          <div class="space-y-6">
            {education.map((edu, index) => (
              <TimeLine
                title={edu.title}
                subtitle={edu.subtitle}
                showLine={index < education.length - 1}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Base>
