---
// Imports
import StickyConversionCta from '@components/StickyConversionCta.astro';
import { Footer } from '@partials/Footer';
import CTA from '@sections/CTA.astro';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import { RELATED_BLOG_PROJECTS } from '../../content/_curation';

export interface Props {
  project: CollectionEntry<'project'>;
}

// Fetch all projects to generate static paths
export async function getStaticPaths() {
  const projects = await getCollection('project');

  const projectsResult = projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));

  return [...projectsResult];
}

const { project } = Astro.props;
const { Content } = await project.render();
const allPosts = await getCollection('post');

const { title, description, startDate, category, projectNote } = project.data;
const categories = category.split(', ');
const relatedPosts = allPosts.filter((post) =>
  RELATED_BLOG_PROJECTS[post.slug]?.includes(project.slug)
);

const titleSuffix = ` - ${AppConfig.site_name}`;
const pageTitle = `${title}${titleSuffix}`;
const pageUrl = `${AppConfig.site_url}/projects/${project.slug}/`;
---

<Base head={{ title: pageTitle, description, url: pageUrl }}>
  <div class="animate-fadeIn container mx-auto px-0 py-8 sm:py-12">
    <!-- Project Header -->
    <div class="mb-8 rounded-2xl p-5 shadow-xl sm:p-6">
      <h1
        class="text-gradient mb-4 break-words bg-gradient-to-r from-purple-600 to-blue-500 bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
      >
        {title}
      </h1>
      <p class="mb-4 break-words leading-7">{description}</p>
      <div class="mb-4 rounded-xl border border-base-300 bg-base-200/40 p-3">
        <p class="text-sm font-semibold">Project context</p>
        <p class="mt-1 break-words text-sm leading-6">{projectNote}</p>
      </div>
      <div
        class="mb-4 flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:justify-between"
      >
        <span class="text-sm "
          >Date: {new Date(startDate).toLocaleDateString()}
        </span>
        <div class="flex flex-wrap gap-2">
          {categories.map((tag) => (
            <span class="rounded-full bg-blue-100 px-3 py-1 text-center text-xs leading-5 text-blue-600">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Project Content -->
    <Content />

    {relatedPosts.length > 0 && (
      <div class="mt-8 rounded-2xl border border-base-300 p-5 sm:p-6">
        <h2 class="text-xl font-semibold">Related writing</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">
          {relatedPosts.map((post) => (
            <li>
              <a
                href={post.data.url}
                target="_blank"
                rel="noreferrer"
                class="hover:text-cyan-400"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="pt-6 lg:grid lg:grid-cols-2">
    <CTA />
  </div>
  <Footer />
  <StickyConversionCta
    primaryHref="mailto:hello@virajbahulkar.me"
    primaryLabel="Contact"
    secondaryHref="/cv/"
    secondaryLabel="View resume"
  />
</Base>
