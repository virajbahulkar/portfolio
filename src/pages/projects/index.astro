---
import { PaginationHeader } from '@components/PaginationHeader';
import { ProjectGallery } from '@components/ProjectGallery';
import { Footer } from '@partials/Footer';
import CTA from '@sections/CTA.astro';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import { sortProjectsByDate } from '@utils/Posts';
// eslint-disable-next-line import/no-unresolved
import { getCollection } from 'astro:content';

const allProjects = await getCollection('project');
const sortedProjects = sortProjectsByDate(allProjects);
const isProjectEntry = (
  project: (typeof allProjects)[number] | undefined
): project is (typeof allProjects)[number] => Boolean(project);
const flagshipProjectOrder = [
  'cognizant-finance-group-app',
  'tooljet',
  'wanderwhale-travel-portal',
];
const flagshipProjects = flagshipProjectOrder
  .map((slug) => allProjects.find((project) => project.slug === slug))
  .filter(isProjectEntry);
const archiveProjects = sortedProjects.filter(
  (project) => !flagshipProjectOrder.includes(project.slug)
);

const titleSuffix = ` - ${AppConfig.site_name}`;
const titleBase = `Engineering`;
const title = titleBase + titleSuffix;
const description =
  'Engineering case studies covering backend systems, cloud infrastructure, Kubernetes, CI/CD, observability, and open-source delivery.';
const url = `${AppConfig.site_url}/projects/`;
---

<Base head={{ title, description, url }}>
  <div class="space-y-12 p-4 md:min-h-screen">
    <div
      class="mx-auto max-w-5xl rounded-3xl border border-base-300 p-8 shadow-xl"
    >
      <PaginationHeader
        title="Engineering case studies"
        description="Selected work showing how application development, backend systems, cloud infrastructure, CI/CD, observability, and operational reliability come together in production."
        extraClasses={{
          headerClasses:
            'text-3xl font-bold text-gradient bg-gradient-to-r from-purple-600 to-blue-500 bg-clip-text text-transparent',
          descriptionClasses: 'mt-4 text-lg leading-8',
        }}
      />
    </div>

    <section class="mx-auto max-w-7xl">
      <div class="mb-6 max-w-3xl">
        <h2 class="text-2xl font-bold">Flagship case studies</h2>
        <p class="mt-3 leading-7">
          These projects best represent backend delivery, cloud infrastructure,
          Kubernetes, performance, and production ownership.
        </p>
      </div>
      <ProjectGallery client:load projectList={flagshipProjects} />
    </section>

    <section class="mx-auto max-w-7xl">
      <div class="mb-6 max-w-3xl">
        <h2 class="text-2xl font-bold">Engineering archive</h2>
        <p class="mt-3 leading-7">
          Additional delivery work across application platforms, internal tools,
          workflow automation, and product-facing systems.
        </p>
      </div>
      <ProjectGallery
        client:load
        projectList={archiveProjects}
        isotopeMode={true}
      />
    </section>
  </div>

  <div class="flex flex-col overflow-auto p-6 lg:grid lg:grid-cols-2">
    <CTA />
  </div>
  <Footer />
</Base>
