---
import { PaginationHeader } from '@components/PaginationHeader';
import { ProjectGallery } from '@components/ProjectGallery';
import StickyConversionCta from '@components/StickyConversionCta.astro';
import { Footer } from '@partials/Footer';
import CTA from '@sections/CTA.astro';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import { sortProjectsByDate } from '@utils/Posts';
// eslint-disable-next-line import/no-unresolved
import { getCollection } from 'astro:content';

import { FLAGSHIP_PROJECT_SLUGS } from '../../content/_curation';

const allProjects = await getCollection('project');
const sortedProjects = sortProjectsByDate(allProjects);
const isProjectEntry = (
  project: (typeof allProjects)[number] | undefined
): project is (typeof allProjects)[number] => Boolean(project);
const flagshipProjects = FLAGSHIP_PROJECT_SLUGS.map((slug) =>
  allProjects.find((project) => project.slug === slug)
).filter(isProjectEntry);
const archiveProjects = sortedProjects.filter(
  (project) => !FLAGSHIP_PROJECT_SLUGS.includes(project.slug)
);

const titleSuffix = ` - ${AppConfig.site_name}`;
const titleBase = `Projects & Engineering Work`;
const title = titleBase + titleSuffix;
const description =
  'Projects spanning web applications, backend services, cloud infrastructure and open-source contributions.';
const url = `${AppConfig.site_url}/projects/`;
---

<Base head={{ title, description, url }}>
  <div class="space-y-12 p-4 md:min-h-screen">
    <div
      class="mx-auto max-w-5xl rounded-3xl border border-base-300 p-8 shadow-xl"
    >
      <PaginationHeader
        title="Projects & Engineering Work"
        description="A selection of projects I’ve worked on, from web applications and backend services to cloud infrastructure and open-source contributions."
        extraClasses={{
          headerClasses:
            'text-3xl font-bold text-gradient bg-gradient-to-r from-purple-600 to-blue-500 bg-clip-text text-transparent',
          descriptionClasses: 'mt-4 text-lg leading-8',
        }}
      />
    </div>

    <section class="mx-auto max-w-7xl">
      <div class="mb-6 max-w-3xl">
        <h2 class="text-2xl font-bold">Selected Work</h2>
        <p class="mt-3 leading-7">
          Professional application work, open-source contributions and a personal
          AWS infrastructure blueprint.
        </p>
      </div>
      <ProjectGallery client:load projectList={flagshipProjects} />
    </section>

    <section class="mx-auto max-w-7xl">
      <div class="mb-6 max-w-3xl">
        <h2 class="text-2xl font-bold">Other Projects</h2>
        <p class="mt-3 leading-7">
          More of my work on internal tools, dashboards, forms and workflow
          automation.
        </p>
      </div>
      <ProjectGallery
        client:load
        projectList={archiveProjects}
        isotopeMode={true}
      />
    </section>

    <section class="mx-auto max-w-7xl rounded-2xl border border-base-300 p-6">
      <h2 class="text-xl font-semibold">Related writing</h2>
      <p class="mt-2 text-sm leading-6">
        Read about implementation choices and lessons learned in my
        <a href="/blogs/" class="text-cyan-400 hover:underline"
          >articles and notes
        </a>.
      </p>
    </section>
  </div>

  <div class="flex flex-col overflow-auto p-6 lg:grid lg:grid-cols-2">
    <CTA />
  </div>
  <StickyConversionCta
    primaryHref="mailto:hello@virajbahulkar.me"
    primaryLabel="Contact"
    secondaryHref="/cv/"
    secondaryLabel="View resume"
  />
  <Footer />
</Base>
