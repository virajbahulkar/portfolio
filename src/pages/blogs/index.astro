---
import { BlogGallery } from '@components/BlogGallery';
import { PaginationHeader } from '@components/PaginationHeader';
import StickyConversionCta from '@components/StickyConversionCta.astro';
import { Footer } from '@partials/Footer';
import CTA from '@sections/CTA.astro';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import { sortPostByDate } from '@utils/Posts';
// eslint-disable-next-line import/no-unresolved
import { getCollection } from 'astro:content';

import {
  FEATURED_BLOG_SLUGS,
  RELATED_BLOG_PROJECTS,
} from '../../content/_curation';

const allPosts = await getCollection('post');
const allProjects = await getCollection('project');
const sortedPosts = sortPostByDate(allPosts);
const isPostEntry = (
  post: (typeof allPosts)[number] | undefined
): post is (typeof allPosts)[number] => Boolean(post);
const featuredPosts = FEATURED_BLOG_SLUGS.map((slug) =>
  allPosts.find((post) => post.slug === slug)
).filter(isPostEntry);
const remainingPosts = sortedPosts.filter(
  (post) => !FEATURED_BLOG_SLUGS.includes(post.slug)
);

const titleSuffix = ` - ${AppConfig.site_name}`;
const titleBase = `Writing & Notes`;
const title = titleBase + titleSuffix;
const description =
  'Articles and notes on software development, backend engineering, cloud technologies and developer tools.';
const url = `${AppConfig.site_url}/blogs/`;
---

<Base head={{ title, description, url }}>
  <section>
    <PaginationHeader
      title="Writing & Notes"
      description="I write about things I’ve built, problems I’ve worked through and technologies I’ve been learning."
    />

    <div class="mb-12 mt-8 flex flex-col items-center space-y-4">
      <div class="circle-animation"></div>
      <p class="max-w-xl text-center  text-lg">
        You’ll find articles on software development, backend engineering,
        cloud technologies and developer tools.
      </p>
    </div>
  </section>

  <section class="mb-12">
    <div class="rounded-3xl border border-base-300 p-6 shadow-xl">
      <h2 class="text-2xl font-bold">Featured Articles</h2>
      <p class="mt-3 max-w-3xl leading-7">
        A few articles that cover projects and technical topics I’ve spent time
        working on.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {featuredPosts.map((post) => (
          <a
            href={post.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-2xl border border-base-300 bg-base-100 p-5 transition hover:-translate-y-1"
          >
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">
              Featured
            </p>
            <h3 class="mt-3 text-lg font-semibold">{post.data.title}</h3>
            <p class="mt-2 text-xs text-base-content/70">
              {new Date(post.data.pubDate).toLocaleDateString()} ·{' '}
              {post.data.readTime}
            </p>
            <div class="mt-2 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="badge badge-outline text-xs">{tag}</span>
              ))}
            </div>
            <p class="mt-3 text-sm leading-6">{post.data.description}</p>
            {RELATED_BLOG_PROJECTS[post.slug]?.[0] && (
              <p class="mt-3 text-xs text-cyan-400">
                Related case study:{' '}
                {
                  allProjects.find(
                    (project) =>
                      project.slug === RELATED_BLOG_PROJECTS[post.slug]?.[0]
                  )?.data.title
                }
              </p>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="mb-4 px-4">
      <h2 class="text-2xl font-bold">All Articles</h2>
      <p class="mt-2 text-sm text-base-content/70">
        Browse my other articles, tutorials and technical notes.
      </p>
    </div>
    <div class="grid grid-cols-1  gap-6 p-4">
      {remainingPosts.length > 0 ? (
        <BlogGallery postList={remainingPosts} />
      ) : (
        <p class="rounded-2xl border border-base-300 p-4 text-sm text-base-content/80">
          All articles are currently listed in the featured section above.
        </p>
      )}
    </div>
  </section>

  <div class="flex flex-col overflow-auto p-6 lg:grid lg:grid-cols-2">
    <CTA />
  </div>
  <StickyConversionCta
    primaryHref="mailto:hello@virajbahulkar.me"
    primaryLabel="Contact"
    secondaryHref="/cv/"
    secondaryLabel="View resume"
  />
  <Footer />
</Base>
