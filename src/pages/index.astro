---
import BackToTop from '@components/BackToTop.astro';
import { Footer } from '@partials/Footer';
import { Hero } from '@partials/Hero';
import { RecentOssProjects } from '@partials/RecentOssProjects';
import { RecentPosts } from '@partials/RecentPosts';
import { RecentProjects } from '@partials/RecentProjects';
import CTA from '@sections/CTA.astro';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import { sortByRunningOrder, sortPostByDate } from '@utils/Posts';
// eslint-disable-next-line import/no-unresolved
import { getCollection } from 'astro:content';

const allPosts = await getCollection('post');
const sortedPosts = sortPostByDate(allPosts);
const lastThreePosts = sortedPosts.slice(0, 4);
const allProjects = await getCollection('project');
const isProjectEntry = (
  project: (typeof allProjects)[number] | undefined
): project is (typeof allProjects)[number] => Boolean(project);
const flagshipProjectOrder = [
  'cognizant-finance-group-app',
  'tooljet',
  'wanderwhale-travel-portal',
];
const flagshipProjects = flagshipProjectOrder
  .map((slug) => allProjects.find((project) => project.slug === slug))
  .filter(isProjectEntry);
const openSourceProjects = sortByRunningOrder(
  allProjects.filter(
    (project) =>
      project.data.openSource && !flagshipProjectOrder.includes(project.slug)
  )
).slice(0, 3);
const engineeringImpact = [
  {
    title: 'Experience',
    metric: '8+ years',
    description:
      'Professional software engineering experience across full-stack delivery, backend systems, and production infrastructure.',
  },
  {
    title: 'Scale',
    metric: '50K DAU',
    description:
      'Finance platform evidence includes production workloads serving 50K daily active users.',
  },
  {
    title: 'Reliability',
    metric: '99.9% uptime',
    description:
      'Customer-facing finance journeys were supported with uptime, observability, and release controls.',
  },
  {
    title: 'Container orchestration',
    metric: '5 → 50 replicas',
    description:
      'Kubernetes scaling evidence shows workloads expanding from 5 to 50 replicas under load.',
  },
  {
    title: 'Cost efficiency',
    metric: '35% optimization',
    description:
      'Infrastructure tuning and right-sizing contributed to 35% infrastructure cost optimization.',
  },
  {
    title: 'Performance',
    metric: '60% latency reduction',
    description:
      'ToolJet contributions include a 60% reduction in backend query latency on key workflows.',
  },
];
const coreEngineeringAreas = [
  {
    title: 'Backend & Distributed Systems',
    description:
      'Node.js, TypeScript, APIs, microservices, SQL and NoSQL data stores, performance tuning, and production-facing application logic.',
  },
  {
    title: 'Platform & Cloud',
    description:
      'AWS, Azure, Docker, Kubernetes, CI/CD, release automation, containerized delivery, and cloud deployment workflows.',
  },
  {
    title: 'Reliability & Observability',
    description:
      'Logging, metrics, alerting, uptime, health checks, monitoring, and production troubleshooting to keep systems stable.',
  },
  {
    title: 'Frontend Foundation',
    description:
      'React and TypeScript remain part of the foundation, but are positioned in service of complete product and platform delivery.',
  },
];
const careerEvolution = [
  'Full-Stack Engineering',
  'Backend Engineering',
  'Cloud-Native Delivery',
  'Platform Engineering',
];
const recruiterCtas = [
  { href: '/projects/', label: 'View engineering work' },
  { href: '/cv/', label: 'View resume' },
  { href: 'mailto:hello@virajbahulkar.me', label: 'Contact' },
];
const platformEngineeringHighlights = [
  {
    title: 'Career direction',
    metric: 'Backend • Platform • Cloud',
    description:
      'The portfolio is intentionally positioned around software engineering depth plus increasing ownership of production infrastructure.',
  },
  {
    title: 'Open source proof',
    metric: 'Self-hosted systems',
    description:
      'Open-source contributions reinforce work on real code paths, delivery quality, and production-conscious engineering.',
  },
  {
    title: 'Delivery model',
    metric: 'Code → production',
    description:
      'Case studies focus on how applications are built, shipped, monitored, scaled, and kept reliable after release.',
  },
  {
    title: 'Future direction',
    metric: 'Selective SRE path',
    description:
      'The narrative shows credible movement from full-stack delivery toward platform engineering and reliability work.',
  },
];

const { title, description, ogImage } = AppConfig;
---

<!-- Base -->
<Base head={{ title, description, ogImage }}>
  <div
    class="grid grid-cols-1 gap-10 lg:h-screen lg:grid-cols-5 lg:grid-rows-[auto,1fr,auto]"
  >
    <!-- Left Column -->
    <div class="flex flex-col justify-between lg:col-span-3">
      <div>
        <div class="flex overflow-auto p-6">
          <Hero
            client:load
            heading={{
              text: 'Senior Software Engineer',
              class: 'text-4xl lg:text-5xl',
            }}
            phrases={[
              {
                text: 'Backend • Platform • Cloud',
                gradient: 'from-indigo-400 via-purple-500 to-pink-500',
              },
            ]}
            description="Building and operating production systems across Node.js, TypeScript, AWS/Azure, Kubernetes, CI/CD, and observability. Strong application engineering foundation with increasing ownership of platform reliability and cloud delivery."
          >
            <div class="mt-6 flex flex-wrap gap-3">
              <span
                class="rounded-full border border-base-300 px-4 py-2 text-sm font-medium"
              >
                8+ years professional experience
              </span>
              {recruiterCtas.map((cta, index) => (
                <a
                  href={cta.href}
                  class={`rounded-full px-4 py-2 text-sm font-semibold transition-colors ${
                    index === 0
                      ? 'bg-primary text-white hover:bg-secondary'
                      : 'border border-base-300 hover:border-primary hover:text-primary'
                  }`}
                >
                  {cta.label}
                </a>
              ))}
            </div>
          </Hero>
        </div>

        <section class="px-6 pb-6">
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {engineeringImpact.map((item) => (
              <article class="rounded-2xl border border-base-300 p-5 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">
                  {item.title}
                </p>
                <p class="mt-2 text-2xl font-bold">{item.metric}</p>
                <p class="mt-3 text-sm leading-6">{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="px-6 pb-6">
          <div class="rounded-3xl border border-base-300 p-8 shadow-xl">
            <h2 class="text-2xl font-bold">Core engineering areas</h2>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              {coreEngineeringAreas.map((area) => (
                <article class="rounded-2xl border border-base-300 bg-base-200/40 p-6">
                  <h3 class="text-lg font-semibold">{area.title}</h3>
                  <p class="mt-3 leading-7">{area.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="px-6 pb-6">
          <div class="rounded-3xl border border-base-300 p-8 shadow-xl">
            <h2 class="text-2xl font-bold">Career evolution</h2>
            <p class="mt-3 max-w-3xl leading-7">
              I started by building product-facing applications end to end. That
              foundation now informs how I think about backend architecture,
              cloud-native delivery, and the platform layers that keep software
              reliable in production.
            </p>
            <div
              class="mt-6 flex flex-wrap items-center gap-3 text-sm font-medium"
            >
              {careerEvolution.map((step, index) => (
                <>
                  <span class="rounded-full border border-base-300 px-4 py-2">
                    {step}
                  </span>
                  {index < careerEvolution.length - 1 && (
                    <span class="text-base-content/50">→</span>
                  )}
                </>
              ))}
            </div>
          </div>
        </section>
      </div>

      <!-- CTA and Footer (desktop) -->
      <div class="hidden flex-col overflow-auto p-6 lg:flex">
        <CTA />
        <Footer />
      </div>
    </div>

    <!-- Right Column -->
    <div class="lg:col-span-2">
      <div
        class="flex items-center justify-center overflow-auto bg-base-200/40 p-6"
      >
        <RecentProjects projectList={flagshipProjects} />
      </div>
      <div
        class="flex items-center justify-center overflow-auto bg-base-200/20 p-6"
      >
        <RecentOssProjects projectList={openSourceProjects} />
      </div>
      <div class="flex items-center justify-center overflow-auto p-6">
        <RecentPosts postList={lastThreePosts} />
      </div>

      <!-- CTA and Footer (mobile & tablet) -->
      <div class="flex flex-col overflow-auto p-6 lg:hidden">
        <CTA />
        <Footer />
      </div>
    </div>
  </div>

  <section class="px-6 pb-12">
    <div
      class="mx-auto max-w-7xl rounded-3xl border border-base-300 p-8 shadow-xl"
    >
      <div class="max-w-3xl">
        <p
          class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400"
        >
          Positioning
        </p>
        <h2 class="mt-3 text-3xl font-bold">
          Engineering credibility beyond application code
        </h2>
        <p class="mt-4 text-lg leading-8">
          The site is deliberately framed around software engineering depth plus
          growing ownership of backend systems, cloud infrastructure, release
          automation, and production reliability.
        </p>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {platformEngineeringHighlights.map((item) => (
          <article class="rounded-2xl border border-base-300 bg-base-200/40 p-6">
            <p class="text-sm uppercase tracking-widest text-cyan-400">
              {item.title}
            </p>
            <p class="mt-3 text-2xl font-bold">{item.metric}</p>
            <p class="mt-4 leading-7">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <BackToTop />
</Base>
