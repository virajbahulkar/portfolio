---
import BackToTop from '@components/BackToTop.astro';
import { Footer } from '@partials/Footer';
import { Hero } from '@partials/Hero';
import { RecentOssProjects } from '@partials/RecentOssProjects';
import { RecentPosts } from '@partials/RecentPosts';
import { RecentProjects } from '@partials/RecentProjects';
import CTA from '@sections/CTA.astro';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import { sortByRunningOrder } from '@utils/Posts';
// eslint-disable-next-line import/no-unresolved
import { getCollection } from 'astro:content';

import {
  FEATURED_BLOG_SLUGS,
  FLAGSHIP_PROJECT_SLUGS,
  RELATED_BLOG_PROJECTS,
} from '../content/_curation';

const allPosts = await getCollection('post');
const isPostEntry = (
  post: (typeof allPosts)[number] | undefined
): post is (typeof allPosts)[number] => Boolean(post);
const lastThreePosts = FEATURED_BLOG_SLUGS.map((slug) =>
  allPosts.find((post) => post.slug === slug)
).filter(isPostEntry);
const allProjects = await getCollection('project');
const relatedCaseStudies = lastThreePosts.flatMap((post) =>
  allProjects
    .filter((project) =>
      RELATED_BLOG_PROJECTS[post.slug]?.includes(project.slug)
    )
    .map((project) => ({ post, project }))
);
const isProjectEntry = (
  project: (typeof allProjects)[number] | undefined
): project is (typeof allProjects)[number] => Boolean(project);
const flagshipProjects = FLAGSHIP_PROJECT_SLUGS.map((slug) =>
  allProjects.find((project) => project.slug === slug)
).filter(isProjectEntry);
const openSourceProjects = sortByRunningOrder(
  allProjects.filter(
    (project) =>
      project.data.openSource && !FLAGSHIP_PROJECT_SLUGS.includes(project.slug)
  )
).slice(0, 3);
const engineeringImpact = [
  {
    title: 'Experience',
    metric: '8+ years',
    description:
      'Delivering enterprise and client applications, backend services and production infrastructure.',
  },
  {
    title: 'Backend services',
    metric: 'Node.js',
    description:
      'Production APIs, microservices and integrations with SQL and NoSQL databases.',
  },
  {
    title: 'Cloud technologies',
    metric: 'AWS & Azure',
    description:
      'Kubernetes autoscaling, release gates, monitoring and production troubleshooting.',
  },
  {
    title: 'Full-stack foundation',
    metric: 'React & Node.js',
    description:
      'Customer-facing finance and travel workflows, reporting dashboards and internal tools.',
  },
  {
    title: 'Open source',
    metric: 'Contributions',
    description:
      'Contributions to ToolJet and Chatwoot, with links to my work.',
  },
  {
    title: 'Personal project',
    metric: 'AWS blueprint',
    description:
      'Terraform, Kubernetes and a sample Node.js service in this repository.',
  },
];
const coreEngineeringAreas = [
  {
    title: 'Backend Engineering',
    description:
      'Designing Node.js APIs and microservices, integrating SQL and NoSQL data stores, and improving production service performance.',
  },
  {
    title: 'Platform & Cloud Engineering',
    description:
      'Operating AWS and Azure workloads with Docker, Kubernetes autoscaling and Azure DevOps release controls across environments.',
  },
  {
    title: 'Performance & Reliability',
    description:
      'Investigating production issues with centralized logs, metrics and alerts, and using health checks and post-release validation to support reliable delivery.',
  },
  {
    title: 'Full-Stack Development',
    description:
      'Building web applications with React, Node.js and TypeScript, from user interfaces to APIs and database integrations.',
  },
];
const careerEvolution = [
  'React & Node.js full-stack development',
  'Backend systems',
  'Platform & cloud engineering',
  'Production engineering',
];
const recruiterCtas = [
  { href: '/projects/', label: 'View engineering work' },
  { href: '/cv/', label: 'View resume' },
  { href: 'mailto:hello@virajbahulkar.me', label: 'Contact' },
];

const { title, description, ogImage } = AppConfig;
---

<!-- Base -->
<Base head={{ title, description, ogImage }}>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-5">
    <!-- Left Column -->
    <div class="flex flex-col justify-between lg:col-span-3">
      <div>
        <div class="flex overflow-auto p-6">
          <Hero
            client:load
            heading={{
              text: 'Senior Software Engineer',
              class: 'text-4xl lg:text-5xl',
            }}
            phrases={[
              {
                text: '| Backend, Platform & Cloud',
                gradient: 'from-indigo-400 via-purple-500 to-pink-500',
              },
            ]}
            description="Hi, I’m Viraj, a Senior Software Engineer building Node.js backend systems, cloud infrastructure and production services on AWS and Azure. With over 8 years of professional experience, I work on APIs, database integrations, Kubernetes workloads, CI/CD release controls and production observability. I bring a full-stack foundation in React and Node.js to backend, platform and cloud engineering."
          >
            <div class="mt-6 flex flex-wrap gap-3">
              <span
                class="rounded-full border border-base-300 px-4 py-2 text-sm font-medium"
              >
                8+ years professional experience
              </span>
              {recruiterCtas.map((cta, index) => (
                <a
                  href={cta.href}
                  class={`rounded-full px-4 py-2 text-sm font-semibold transition-colors ${
                    index === 0
                      ? 'bg-primary text-white hover:bg-secondary'
                      : 'border border-base-300 hover:border-primary hover:text-primary'
                  }`}
                >
                  {cta.label}
                </a>
              ))}
            </div>
          </Hero>
        </div>

        <section class="px-6 pb-6">
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {engineeringImpact.map((item) => (
              <article class="rounded-2xl border border-base-300 p-5 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">
                  {item.title}
                </p>
                <p class="mt-2 text-2xl font-bold">{item.metric}</p>
                <p class="mt-3 text-sm leading-6">{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="px-6 pb-6">
          <div class="rounded-3xl border border-base-300 p-8 shadow-xl">
            <h2 class="text-2xl font-bold">Core engineering areas</h2>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              {coreEngineeringAreas.map((area) => (
                <article class="rounded-2xl border border-base-300 bg-base-200/40 p-6">
                  <h3 class="text-lg font-semibold">{area.title}</h3>
                  <p class="mt-3 leading-7">{area.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- Right Column -->
    <div class="lg:col-span-2">
      <div
        class="flex items-center justify-center overflow-auto bg-base-200/40 p-6"
      >
        <RecentProjects projectList={flagshipProjects} />
      </div>
      <div
        class="flex items-center justify-center overflow-auto bg-base-200/20 p-6"
      >
        <RecentOssProjects projectList={openSourceProjects} />
      </div>
      <div class="flex items-center justify-center overflow-auto p-6">
        <div class="space-y-4">
          <RecentPosts postList={lastThreePosts} />
          {relatedCaseStudies.length > 0 && (
            <div class="rounded-2xl border border-base-300 p-4 text-sm">
              <p class="font-semibold">Related case studies</p>
              <ul class="mt-2 space-y-2">
                {relatedCaseStudies.map(({ post, project }) => (
                  <li>
                    <a
                      class="hover:text-cyan-400"
                      href={`/projects/${project.slug}/`}
                    >
                      {post.data.title} → {project.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <section class="px-6 pb-6">
    <div
      class="mx-auto max-w-7xl rounded-3xl border border-base-300 p-8 shadow-xl"
    >
      <h2 class="text-2xl font-bold">A Little About My Journey</h2>
      <p class="mt-3 max-w-3xl leading-7">
        I started with full-stack development using React and Node.js, building
        applications for insurance, travel and internal business workflows.
        After managing development and releases as a Technical Head, I expanded
        into backend, platform and cloud engineering. Today, my work includes
        enterprise finance services, AWS and Azure infrastructure, and the
        monitoring and release controls that support production systems.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm font-medium">
        {careerEvolution.map((step, index) => (
          <>
            <span class="rounded-full border border-base-300 px-4 py-2">
              {step}
            </span>
            {index < careerEvolution.length - 1 && (
              <span class="text-base-content/50">·</span>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <div class="p-6">
    <CTA />
    <Footer />
  </div>

  <BackToTop />
</Base>
