---
import { Footer } from '@partials/Footer';
import { Hero } from '@partials/Hero';
import { RecentOssProjects } from '@partials/RecentOssProjects';
import { RecentPosts } from '@partials/RecentPosts';
import { RecentProjects } from '@partials/RecentProjects';
import CTA from '@sections/CTA.astro';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import { sortByRunningOrder } from '@utils/Posts';
// eslint-disable-next-line import/no-unresolved
import { getCollection } from 'astro:content';

import {
  FEATURED_BLOG_SLUGS,
  FLAGSHIP_PROJECT_SLUGS,
  RELATED_BLOG_PROJECTS,
} from '../content/_curation';

const allPosts = await getCollection('post');
const isPostEntry = (
  post: (typeof allPosts)[number] | undefined
): post is (typeof allPosts)[number] => Boolean(post);
const lastThreePosts = FEATURED_BLOG_SLUGS.map((slug) =>
  allPosts.find((post) => post.slug === slug)
).filter(isPostEntry);
const allProjects = await getCollection('project');
const relatedCaseStudies = lastThreePosts.flatMap((post) =>
  allProjects
    .filter((project) =>
      RELATED_BLOG_PROJECTS[post.slug]?.includes(project.slug)
    )
    .map((project) => ({ post, project }))
);
const isProjectEntry = (
  project: (typeof allProjects)[number] | undefined
): project is (typeof allProjects)[number] => Boolean(project);
const flagshipProjects = FLAGSHIP_PROJECT_SLUGS.map((slug) =>
  allProjects.find((project) => project.slug === slug)
).filter(isProjectEntry);
const openSourceProjects = sortByRunningOrder(
  allProjects.filter(
    (project) =>
      project.data.openSource && !FLAGSHIP_PROJECT_SLUGS.includes(project.slug)
  )
).slice(0, 3);
const engineeringImpact = [
  {
    title: 'Experience',
    metric: '8+ years',
    description:
      'Shipping production software across backend services, cloud platforms and application delivery.',
  },
  {
    title: 'Backend focus',
    metric: 'Node.js',
    description:
      'Designing APIs, integrations and service logic with SQL and NoSQL data stores.',
  },
  {
    title: 'Platform & cloud',
    metric: 'AWS · Azure · Kubernetes',
    description:
      'Running workloads with release controls, observability and production reliability practices.',
  },
  {
    title: 'Delivery model',
    metric: 'CI/CD + Observability',
    description:
      'Combining deployment automation, health checks and monitoring to support stable releases.',
  },
];
const coreEngineeringAreas = [
  {
    title: 'Backend Engineering',
    description:
      'Building Node.js and TypeScript services, APIs and integrations that support business-critical application workflows.',
  },
  {
    title: 'Platform & Cloud Engineering',
    description:
      'Operating AWS and Azure environments with container orchestration, deployment controls and infrastructure automation.',
  },
  {
    title: 'Performance & Reliability',
    description:
      'Improving production stability with monitoring, troubleshooting workflows and post-release validation.',
  },
];
const careerEvolution = [
  'React & Node.js full-stack development',
  'Backend systems',
  'Platform & cloud engineering',
  'Production engineering',
];
const recruiterCtas = [
  { href: '/projects/', label: 'View engineering work' },
  { href: '/cv/', label: 'View resume' },
  { href: 'mailto:hello@virajbahulkar.me', label: 'Contact' },
];
const professionalSubtitle = 'Node.js · TypeScript · AWS · Azure · Kubernetes';

const { title, description, ogImage } = AppConfig;
---

<!-- Base -->
<Base head={{ title, description, ogImage }}>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-5 lg:gap-10">
    <!-- Left Column -->
    <div class="flex flex-col justify-between lg:col-span-3">
      <div>
        <div class="px-0 pb-6 pt-2">
          <Hero
            client:load
            heading={{
              text: 'Senior Software Engineer',
              class: 'text-3xl sm:text-4xl lg:text-5xl',
            }}
            phrases={[
              {
                text: '| Backend, Platform & Cloud',
                gradient: 'from-indigo-400 via-purple-500 to-pink-500',
              },
            ]}
            description="Hi, I’m Viraj, a Senior Software Engineer focused on backend, platform and cloud engineering. I build Node.js services and run production workloads on AWS and Azure with Kubernetes, CI/CD controls and observability."
          >
            <div class="mt-6 flex flex-wrap gap-3">
              <span
                class="rounded-full border border-base-300 px-4 py-2 text-xs font-medium sm:text-sm"
              >
                8+ years professional experience
              </span>
              {recruiterCtas.map((cta, index) => (
                <a
                  href={cta.href}
                  class={`inline-flex items-center justify-center rounded-full px-4 py-2 text-center text-xs font-semibold transition-colors sm:text-sm ${
                    index === 0
                      ? 'bg-primary text-white hover:bg-secondary'
                      : 'border border-base-300 hover:border-primary hover:text-primary'
                  }`}
                >
                  {cta.label}
                </a>
              ))}
            </div>
          </Hero>
        </div>
        <div
          class="mb-6 rounded-2xl border border-primary/30 bg-gradient-to-r from-base-200 to-base-100 p-4 shadow-sm"
        >
          <p
            class="text-xs font-semibold uppercase tracking-[0.2em] text-base-content/60"
          >
            Core engineering stack
          </p>
          <p
            class="mt-2 text-sm font-semibold tracking-wide text-primary md:text-base"
          >
            {professionalSubtitle}
          </p>
        </div>

        <section class="pb-6">
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {engineeringImpact.map((item) => (
              <article class="rounded-2xl border border-base-300 p-4 shadow-sm sm:p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-400">
                  {item.title}
                </p>
                <p class="mt-2 text-2xl font-bold">{item.metric}</p>
                <p class="mt-3 text-sm leading-6">{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="pb-6">
          <div class="rounded-3xl border border-base-300 p-5 shadow-xl sm:p-8">
            <h2 class="text-xl font-bold sm:text-2xl">Engineering areas</h2>
            <div class="mt-5 grid gap-4 sm:mt-6 sm:gap-6 md:grid-cols-2">
              {coreEngineeringAreas.map((area) => (
                <article class="rounded-2xl border border-base-300 bg-base-200/40 p-5 sm:p-6">
                  <h3 class="text-lg font-semibold">{area.title}</h3>
                  <p class="mt-3 leading-7">{area.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="pb-6">
          <div class="rounded-3xl border border-base-300 p-5 shadow-xl sm:p-8">
            <h2 class="text-xl font-bold sm:text-2xl">
              A Little About My Journey
            </h2>
            <p class="mt-3 max-w-3xl leading-7">
              I started with full-stack development using React and Node.js,
              building applications for insurance, travel and internal business
              workflows. After managing development and releases as a Technical
              Head, I expanded into backend, platform and cloud engineering.
              Today, my work includes enterprise finance services, AWS and Azure
              infrastructure, and the monitoring and release controls that
              support production systems.
            </p>
            <div
              class="mt-6 flex flex-wrap items-center gap-3 text-sm font-medium"
            >
              {careerEvolution.map((step, index) => (
                <>
                  <span class="rounded-full border border-base-300 px-4 py-2">
                    {step}
                  </span>
                  {index < careerEvolution.length - 1 && (
                    <span class="text-base-content/50">·</span>
                  )}
                </>
              ))}
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- Right Column -->
    <div class="lg:col-span-2">
      <div
        class="rounded-3xl border border-base-300 bg-base-100 p-5 shadow-xl sm:p-8"
      >
        <RecentProjects projectList={flagshipProjects} />
      </div>
      <div
        class="mt-6 rounded-3xl border border-base-300 bg-base-100 p-5 shadow-xl sm:p-8"
      >
        <RecentOssProjects projectList={openSourceProjects} />
      </div>
      <div
        class="mt-6 rounded-3xl border border-base-300 bg-base-100 p-5 shadow-xl sm:p-8"
      >
        <div class="space-y-6">
          <RecentPosts postList={lastThreePosts} />
          {relatedCaseStudies.length > 0 && (
            <div class="rounded-2xl border border-base-300 p-4 text-sm">
              <p class="font-semibold">Related case studies</p>
              <ul class="mt-2 space-y-2">
                {relatedCaseStudies.map(({ post, project }) => (
                  <li>
                    <a
                      class="hover:text-cyan-400"
                      href={`/projects/${project.slug}/`}
                    >
                      {post.data.title} → {project.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="pt-6">
    <CTA />
    <Footer />
  </div>
</Base>
