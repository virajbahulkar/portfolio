---
import BackToTop from '@components/BackToTop.astro';
import { Footer } from '@partials/Footer';
import { Hero } from '@partials/Hero';
import { RecentOssProjects } from '@partials/RecentOssProjects';
import { RecentPosts } from '@partials/RecentPosts';
import { RecentProjects } from '@partials/RecentProjects';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import {
  sortByRunningOrder,
  sortPostByDate,
  sortProjectsByDate,
} from '@utils/Posts';
import { getCollection } from 'astro:content';
import CTA from '@sections/CTA.astro';

const allPosts = await getCollection('post');
const sortedPosts = sortPostByDate(allPosts);
const lastThreePosts = sortedPosts.slice(0, 4);
const allProjects = await getCollection('project');
const openSourceProjects = sortByRunningOrder(
  allProjects.filter((project) => project.data.openSource)
).slice(0, 4);
const myProjects = sortProjectsByDate(
  allProjects.filter((project) => !project.data.openSource)
).slice(0, 3);

const { title, description, ogImage } = AppConfig;
---

<!-- Base -->
<Base head={{ title, description, ogImage }}>
  <div
    class="grid grid-cols-1 gap-10 lg:h-screen lg:grid-cols-5 lg:grid-rows-[auto,1fr,auto]"
  >
    <!-- Left Column -->
    <div class="flex flex-col justify-between lg:col-span-3">
      <div>
        <!-- Hero Section - NEW POSITIONING -->
        <div class="lg:items-left lg:justify-left flex overflow-auto p-6">
          <Hero
            client:load
            heading="Viraj Bahulkar"
            phrases={[
              {
                text: 'Senior Software Engineer',
                gradient: 'from-blue-400 via-cyan-500 to-teal-500',
              },
            ]}
            description="8+ years building, deploying and operating scalable enterprise applications across cloud, backend and frontend systems. Expert in AWS/Azure, Docker/Kubernetes, CI/CD automation, Node.js, React and AI/LLM integration."
          />
        </div>

        <!-- Tech Stack & Capabilities -->
        <div class="flex overflow-auto p-6">
          <div class="w-full">
            <h2 class="text-2xl font-bold mb-4">Core Capabilities</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-6">
              <div class="flex items-center space-x-2">
                <span class="text-lg">☁️</span>
                <span class="text-sm font-semibold">Cloud & DevOps</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-lg">⚙️</span>
                <span class="text-sm font-semibold">Backend Systems</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-lg">🎨</span>
                <span class="text-sm font-semibold">Frontend Engineering</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-lg">🤖</span>
                <span class="text-sm font-semibold">AI/LLM Integration</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-lg">📊</span>
                <span class="text-sm font-semibold">System Architecture</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-lg">🔍</span>
                <span class="text-sm font-semibold">Observability</span>
              </div>
            </div>
            <p class="text-sm leading-relaxed">
              <strong>Key Technologies:</strong> AWS · Azure · Docker · Kubernetes · Azure DevOps · CI/CD · Node.js · React · TypeScript · PostgreSQL · Terraform · Prometheus/Grafana
            </p>
          </div>
        </div>

        <!-- CTA Section -->
        <div class="flex overflow-auto p-6">
          <div class="w-full">
            <div class="flex flex-wrap gap-3">
              <a href="/projects" class="inline-block">
                <button class="bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 text-white font-semibold py-2 px-6 rounded-lg transition-all shadow-lg">
                  View Engineering Work
                </button>
              </a>
              <a href="/cv" class="inline-block">
                <button class="bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-semibold py-2 px-6 rounded-lg transition-all shadow-lg">
                  View Resume
                </button>
              </a>
              <a href="mailto:virajbahulkar@gmail.com" class="inline-block">
                <button class="bg-gray-700 hover:bg-gray-800 text-white font-semibold py-2 px-6 rounded-lg transition-all shadow-lg">
                  Contact Me
                </button>
              </a>
            </div>
          </div>
        </div>

        <!-- Engineering Focus Section -->
        <div class="lg:items-left lg:justify-left flex overflow-auto p-6">
          <Hero
            client:load
            heading={{ text: 'Engineering Focus', class: 'text-2xl' }}
            description={[
              {
                text: 'Cloud infrastructure (AWS/Azure) and containerization (Docker/Kubernetes) for scalable, resilient systems',
              },
              {
                text: 'DevOps automation: CI/CD pipelines, Infrastructure-as-Code (Terraform), and deployment strategies',
              },
              {
                text: 'Full-stack architecture: React frontends, Node.js/Express backends, microservices and serverless design',
              },
              {
                text: 'Observability and reliability: monitoring, logging, alerting and incident response',
              },
              {
                text: 'AI-powered solutions: LLM integration, prompt engineering, and intelligent systems',
              },
            ]}
          />
        </div>
      </div>


      <!-- CTA and Footer (desktop) -->
      <div class="hidden flex-col overflow-auto p-6 lg:flex">
        <CTA />
        <Footer />
      </div>
    </div>

    <!-- Right Column -->
    <div class="lg:col-span-2">
      <div
        class="bg-regal-blue flex items-center justify-center overflow-auto p-6"
      >
        <RecentProjects projectList={myProjects} />
      </div>
      <div
        class="bg-to-sky-400 flex items-center justify-center overflow-auto p-6"
      >
        <RecentOssProjects projectList={openSourceProjects} />
      </div>
      <div class="flex items-center justify-center overflow-auto p-6">
        <RecentPosts postList={lastThreePosts} />
      </div>

      <!-- CTA and Footer (mobile & tablet) -->
      <div class="flex flex-col overflow-auto p-6 lg:hidden">
        <CTA />
        <Footer />
      </div>
    </div>
  </div>

  <BackToTop />
</Base>
