---
import BackToTop from '@components/BackToTop.astro';
import { Footer } from '@partials/Footer';
import { Hero } from '@partials/Hero';
import { RecentOssProjects } from '@partials/RecentOssProjects';
import { RecentPosts } from '@partials/RecentPosts';
import { RecentProjects } from '@partials/RecentProjects';
import Base from '@templates/Base.astro';
import { AppConfig } from '@utils/AppConfig';
import {
  sortByRunningOrder,
  sortPostByDate,
  sortProjectsByDate,
} from '@utils/Posts';
import { getCollection } from 'astro:content';
import CTA from '@sections/CTA.astro';

const allPosts = await getCollection('post');
const sortedPosts = sortPostByDate(allPosts);
const lastThreePosts = sortedPosts.slice(0, 4);
const allProjects = await getCollection('project');
const openSourceProjects = sortByRunningOrder(
  allProjects.filter((project) => project.data.openSource)
).slice(0, 4);
const myProjects = sortProjectsByDate(
  allProjects.filter((project) => !project.data.openSource)
).slice(0, 3);
const platformEngineeringHighlights = [
  {
    title: 'Cloud delivery',
    metric: 'AWS + Azure',
    description:
      'Production case studies highlight multi-cloud delivery across regulated and customer-facing systems.',
  },
  {
    title: 'Container orchestration',
    metric: '5 → 50 replicas',
    description:
      'Kubernetes autoscaling, containerized workflows, and production image builds reinforce hands-on platform ownership.',
  },
  {
    title: 'Release discipline',
    metric: 'CI/CD gates',
    description:
      'GitHub Actions, Azure DevOps pipelines, and validation-first delivery emphasize safe and repeatable releases.',
  },
  {
    title: 'Operational outcomes',
    metric: '99.9% uptime',
    description:
      'Observability, performance tuning, and cost optimization are presented as measurable engineering outcomes.',
  },
];

const { title, description, ogImage } = AppConfig;
---

<!-- Base -->
<Base head={{ title, description, ogImage }}>
  <div
    class="grid grid-cols-1 gap-10 lg:h-screen lg:grid-cols-5 lg:grid-rows-[auto,1fr,auto]"
  >
    <!-- Left Column -->
    <div class="flex flex-col justify-between lg:col-span-3">
      <div>
        <!-- Hero Section -->
        <div class="lg:items-left lg:justify-left flex overflow-auto p-6">
          <Hero
            client:load
            heading="Hi there, I'm"
            phrases={[
              {
                text: 'Viraj Bahulkar',
                gradient: 'from-purple-400 via-pink-500 to-red-500',
              },
              {
                text: 'Senior Software Engineer',
                gradient: 'from-green-400 via-blue-500 to-purple-500',
              },
              {
                text: 'Cloud & DevOps Focused',
                gradient: 'from-indigo-400 via-purple-500 to-pink-500',
              },
              {
                text: 'Building Reliable Platforms',
                gradient: 'from-red-400 via-pink-500 to-purple-500',
              },
            ]}
             description="Senior Software Engineer with 7+ years of experience delivering production-grade platforms across frontend, backend, and cloud infrastructure. Hands-on with Docker, Kubernetes, CI/CD, observability, and release discipline to ship scalable systems that stay reliable in production."
          />
        </div>

        <!-- Career Section -->
        <div class="lg:items-left lg:justify-left flex overflow-auto p-6">
          <Hero
            client:load
            heading={{ text: 'My career', class: 'text-2xl' }}
            description="So far, the journey has been about building innovative applications, enhancing web experiences and delivering solutions that make business thrive."
          />
        </div>

        <!-- Platform & DevOps Evidence -->
        <div class="flex overflow-auto p-6">
          <Hero
            client:load
            heading={{ text: 'Platform & DevOps evidence', class: 'text-2xl' }}
            description={[
              {
                text: 'Built cloud-aware project case studies covering AWS, Azure, Kubernetes autoscaling, CI/CD gates, and production observability.',
              },
              {
                text: 'Structured this portfolio around reproducible engineering workflows using Docker, Dev Containers, GitHub Actions CI, and production container builds.',
              },
              {
                text: 'Focused on operational outcomes such as uptime, performance, rollout safety, and cost optimization rather than shipping features alone.',
              },
            ]}
          />
        </div>

        <!-- Things I love Section -->
        <div class="flex overflow-auto p-6">
          <Hero
            client:load
            heading={{ text: 'Things I love to do', class: 'text-2xl' }}
            description={[
              {
                text: 'Continuously experimenting with new frameworks, tools, and libraries to enhance my skills.',
              },
              {
                text: 'Keeping myself updated with industry trends, insights, and expert discussions.',
              },
              {
                text: 'Sharing my learnings, thoughts, and technical insights through writing.',
              },
              {
                text: 'Discovering new places, embracing nature, and drawing inspiration from different experiences.',
              },
            ]}
          />
        </div>

        <!-- Motivation Section -->
        <div class="flex overflow-auto p-6">
          <Hero
            client:load
            heading={{ text: 'My motivation', class: 'text-2xl' }}
            description={[
              {
                text: 'Every line of code you write is a step closer to turning imagination into reality. Keep building, keep evolving',
                type: 'quote',
                class: 'border-l-4 border-blue-500 pl-4 italic text-lg my-4',
              },
            ]}
          />
        </div>
      </div>


      <!-- CTA and Footer (desktop) -->
      <div class="hidden flex-col overflow-auto p-6 lg:flex">
        <CTA />
        <Footer />
      </div>
    </div>

    <!-- Right Column -->
    <div class="lg:col-span-2">
      <div
        class="bg-regal-blue flex items-center justify-center overflow-auto p-6"
      >
        <RecentProjects projectList={myProjects} />
      </div>
      <div
        class="bg-to-sky-400 flex items-center justify-center overflow-auto p-6"
      >
        <RecentOssProjects projectList={openSourceProjects} />
      </div>
      <div class="flex items-center justify-center overflow-auto p-6">
        <RecentPosts postList={lastThreePosts} />
      </div>

      <!-- CTA and Footer (mobile & tablet) -->
      <div class="flex flex-col overflow-auto p-6 lg:hidden">
        <CTA />
        <Footer />
      </div>
    </div>
  </div>

  <section class="px-6 pb-12">
    <div class="mx-auto max-w-7xl rounded-3xl border border-base-300 p-8 shadow-xl">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400">
          DevOps / Platform Engineering
        </p>
        <h2 class="mt-3 text-3xl font-bold">
          Evidence of delivery beyond application code
        </h2>
        <p class="mt-4 text-lg leading-8">
          The portfolio is intentionally structured to show engineering evidence
          across cloud infrastructure, release automation, production
          reliability, and measurable operational results.
        </p>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {platformEngineeringHighlights.map((item) => (
          <article class="rounded-2xl border border-base-300 bg-base-200/40 p-6">
            <p class="text-sm uppercase tracking-widest text-cyan-400">
              {item.title}
            </p>
            <p class="mt-3 text-2xl font-bold">{item.metric}</p>
            <p class="mt-4 leading-7">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <BackToTop />
</Base>
