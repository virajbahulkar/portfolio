---
interface Props {
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
}

const { primaryHref, primaryLabel, secondaryHref, secondaryLabel } =
  Astro.props as Props;
---

<div
  aria-hidden="true"
  data-sticky-cta-spacer
  style="height:var(--sticky-cta-offset, 0px)"
></div>
<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-50 px-4 sm:px-6"
  style="padding-bottom:calc(env(safe-area-inset-bottom, 0px) + 0.75rem)"
>
  <div
    data-sticky-cta
    class="pointer-events-auto mx-auto flex max-w-xl flex-col items-stretch gap-3 rounded-2xl border border-base-300 bg-base-100/95 p-3 shadow-xl backdrop-blur sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-xs font-medium leading-5">Interested in working together?</p>
    <div class="flex flex-wrap gap-2 sm:justify-end">
      <a
        href={secondaryHref}
        class="inline-flex items-center justify-center rounded-full border border-base-300 px-3 py-2 text-center text-xs font-semibold leading-5 transition-colors hover:border-primary hover:text-primary"
      >
        {secondaryLabel}
      </a>
      <a
        href={primaryHref}
        class="inline-flex items-center justify-center rounded-full bg-primary px-3 py-2 text-center text-xs font-semibold leading-5 text-white transition-colors hover:bg-secondary"
      >
        {primaryLabel}
      </a>
    </div>
  </div>
  <script is:inline>
    (() => {
      const updateStickyCtaOffset = () => {
        const cta = document.querySelector('[data-sticky-cta]');
        const spacer = document.querySelector('[data-sticky-cta-spacer]');
        if (!(cta instanceof HTMLElement) || !(spacer instanceof HTMLElement)) {
          return;
        }

        const baseGap = 12;
        const offset = Math.ceil(cta.getBoundingClientRect().height + baseGap);
        spacer.style.setProperty(
          'height',
          `calc(${offset}px + env(safe-area-inset-bottom, 0px))`
        );
      };

      updateStickyCtaOffset();
      window.addEventListener('load', updateStickyCtaOffset, { once: true });
      window.addEventListener('resize', updateStickyCtaOffset);
    })();
  </script>
</div>
