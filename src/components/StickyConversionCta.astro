---
interface Props {
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
}

const { primaryHref, primaryLabel, secondaryHref, secondaryLabel } =
  Astro.props as Props;
---

<div class="pointer-events-none fixed inset-x-0 bottom-4 z-50 px-4">
  <div
    class="pointer-events-auto mx-auto flex max-w-xl items-center justify-between gap-3 rounded-2xl border border-base-300 bg-base-100/95 p-3 shadow-xl backdrop-blur"
  >
    <p class="text-xs font-medium">Interested in working together?</p>
    <div class="flex gap-2">
      <a
        href={secondaryHref}
        class="rounded-full border border-base-300 px-3 py-1 text-xs font-semibold transition-colors hover:border-primary hover:text-primary"
      >
        {secondaryLabel}
      </a>
      <a
        href={primaryHref}
        class="rounded-full bg-primary px-3 py-1 text-xs font-semibold text-white transition-colors hover:bg-secondary"
      >
        {primaryLabel}
      </a>
    </div>
  </div>
</div>
